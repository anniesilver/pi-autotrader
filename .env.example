# Copy to .env on the Pi and adjust.
IB_HOST=127.0.0.1
IB_PORT=4002          # IB Gateway paper. Never point this at 4001 (live) without ALLOW_LIVE=1.
IB_CLIENT_ID=17
IB_ACCOUNT=           # optional, e.g. DU1234567; empty = the only account on the login
DRY_RUN=1             # 1 = decide and report only; set 0 (or pass --send) to place paper orders
ALLOW_LIVE=0
NTFY_TOPIC=           # optional: a hard-to-guess topic name; subscribe to it in the ntfy phone app
