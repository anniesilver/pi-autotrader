# Copy to deploy/gateway.env (never commit it) and fill in your PAPER login.
# The paper account has its own username, shown in Client Portal > Settings > Paper Trading Account.
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper
READ_ONLY_API=no
TIME_ZONE=America/New_York
# Restart Gateway nightly without a new login (IB disconnects everyone around midnight anyway)
AUTO_RESTART_TIME=11:45 PM
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
EXISTING_SESSION_DETECTED_ACTION=primary
TWS_SETTINGS_PATH=/home/ibgateway/tws_settings
SAVE_TWS_SETTINGS=yes
# Optional: set to view the Gateway window over VNC (ssh -L 5900:localhost:5900 pi)
VNC_SERVER_PASSWORD=
JAVA_HEAP_SIZE=768
